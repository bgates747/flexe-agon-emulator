+/* Preserve upstream verbosity for standalone users; the adapter explicitly
+ * selects normal or verbose output before starting the emulation threads. */
+static atomic_bool flexe_debug_logging = true;
+void flexe_set_debug_logging(bool enabled) {
+    atomic_store_explicit(&flexe_debug_logging, enabled, memory_order_relaxed);
+}
+bool flexe_debug_logging_enabled(void) {
+    return atomic_load_explicit(&flexe_debug_logging, memory_order_relaxed);
+}
 
